# Required for real data. Find the ID with: az account list --output table
AZURE_SUBSCRIPTION_ID=

# Optional tenant ID, for identities that can access multiple Microsoft Entra tenants.
AZURE_TENANT_ID=

# Inclusive number of calendar days (1-90), ending today. Today may be incomplete.
FINOPS_DAYS=30

# The API always binds to 127.0.0.1. Do not expose it to the internet.
PORT=5173

# Synthetic offline data only. "npm run demo" enables this without editing .env.
FINOPS_DEMO=false
